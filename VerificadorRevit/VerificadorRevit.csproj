<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 já vem no Windows 10/11: o .exe roda sem instalar nada. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>Verificador de versão do Revit</AssemblyTitle>
    <!-- O atualizador compara com a etiqueta da Release no GitHub (v1.0 = 1.0.0). O publicar.sh sobrescreve. -->
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pacotes do Revit Automation, gerados pelo projeto ..\RevitConversor -->
    <None Include="nuvem\*.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
